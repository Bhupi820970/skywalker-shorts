# Copy to <box home>/box.env (box home = the folder that holds the repo clone) or ~/.config/skywalker/box.env.
# Plain KEY=value, parsed (never executed) by box/env.sh. NO secrets here: just paths and names.
# gh login folder (leave out to use the normal `gh auth login`):
#SKY_GH_CONFIG_DIR=/home/YOUR_USER/.config/gh
# Browser profile with a YouTube browser login that yt-dlp reads (in place, never copied):
#SKY_YTDLP_BROWSER=chrome:/home/YOUR_USER/.config/google-chrome
#SKY_BROWSER_PROFILE_ROOT=/home/YOUR_USER/chrome-profile
# deno is needed by yt-dlp for 1080p+ YouTube formats (auto-detected in ~/.deno/bin):
#SKY_YTDLP_JS_RUNTIME=deno:/home/YOUR_USER/.deno/bin/deno
#SKY_BOX_PYTHON=/home/YOUR_USER/skywalker-box/venv/bin/python
#SKY_BOX_TICK=300
#SKY_BOX_WATCHDOG_INTERVAL=600
# Box may dispatch GitHub workflows itself (off by default; publish also needs SKY_BOX_PUBLISH=1):
#SKY_BOX_DISPATCH=0
#SKY_BOX_PUBLISH=0
